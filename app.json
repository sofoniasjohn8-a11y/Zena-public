      },
      "package": "com.zenabegena.songs",
      "minSdkVersion": 21,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "permissions": []
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zenabegena.songs"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
